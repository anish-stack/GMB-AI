# ---------- XAMPP MySQL ----------
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
# ---------- Auth ----------
SESSION_SECRET=/MG7aQBpU=

# ---------- Ollama (free, local, dev machine only) ----------
# Turn on ONLY on a machine actually running Ollama - leave false/unset on the VPS.
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_TEXT_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ---------- OpenAI (server-side only, primary paid provider) ----------
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_SIZE=1024x1024

# ---------- Gemini (server-side only; text fallback after Ollama, primary image provider) ----------
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# ---------- Hugging Face (server-side only, fallback provider) ----------
HF_API_KEY=
HF_TEXT_MODEL=meta-llama/Llama-3.1-8B-Instruct
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# HF_IMAGE_MODEL=stabilityai/stable-diffusion-xl-base-1.0
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
HF_IMAGE_PROVIDER=auto
# AI provider: openai | ollama | gemini | huggingface | mock
#   openai (default) = Ollama (if enabled) -> Gemini -> OpenAI -> Hugging Face -> Mock
#                       (text prefers Ollama; image generation skips Ollama and starts at Gemini)
#   ollama            = force Ollama only (+ Mock last resort)
#   gemini            = force Gemini only (+ Mock last resort)
#   huggingface       = force Hugging Face only (+ Mock last resort)
#   mock              = deterministic offline generator only, no key needed
AI_PROVIDER=gemini
# Max AI image regenerations allowed per GMB post (manual upload is unlimited)
IMAGE_REGEN_LIMIT=2
# How many options "Generate options" creates at once, and the hard ceiling
IMAGE_OPTIONS_COUNT=3
IMAGE_OPTIONS_COUNT_MAX=6
AI_TIMEOUT_MS=45000
AI_IMAGE_TIMEOUT_MS=60000
AI_MAX_RETRIES=2
AI_JOB_CONCURRENCY=3
# Budget-tier text model rates (per project cost doc, Aug 2026 - reconfirm before budget approval)
AI_COST_PER_1K_INPUT=0.0006
AI_COST_PER_1K_OUTPUT=0.0024
AI_COST_PER_IMAGE=0.003
# ---------- Image storage (server-side only) ----------
# Fallback chain, tried in order until one succeeds: AWS S3 -> Cloudflare R2
# -> Cloudinary -> local disk (always available, last resort).
# Leave STORAGE_PROVIDER blank to use the chain; set it to force one.
STORAGE_PROVIDER=

# AWS S3
AWS_S3_BUCKET=
AWS_S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional CloudFront/custom domain in front of the bucket - defaults to the
# bucket's own regional S3 URL if left blank.
AWS_S3_PUBLIC_URL=

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=
R2_BUCKET=gmb-api
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Required - R2 buckets are private by default. Use an r2.dev subdomain you've
# enabled (Bucket -> Settings -> Public access) or your own custom domain.
R2_PUBLIC_URL=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=

# Local disk (last resort fallback - always on, no keys needed)
IMAGE_STORAGE_DIR=

# Every AI-generated/uploaded image older than this gets deleted from storage.
# A still-PUBLISHED post's live image is skipped by default so a routine sweep
# never breaks a live GMB listing - set the skip flag to false to delete
# unconditionally after IMAGE_RETENTION_DAYS regardless of publish status.
IMAGE_RETENTION_DAYS=90
IMAGE_RETENTION_SKIP_PUBLISHED=true

# ---------- GMB ----------
# mock | google   (google provider is a stub until OAuth is configured)
GMB_PROVIDER=google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GMB_ACCOUNT_ID=
GOOGLE_INVITE_DAYS=14
# ---------- Scheduler ----------
NIGHTLY_CRON=0 0 * * *
# Daily image retention sweep (deletes images older than IMAGE_RETENTION_DAYS)
IMAGE_CLEANUP_CRON=0 2 * * *
APP_URL=
# ---------- SaaS ----------
# Billing sweep: renews, raises invoices, expires past-due subscriptions
BILLING_CRON=30 1 * * *